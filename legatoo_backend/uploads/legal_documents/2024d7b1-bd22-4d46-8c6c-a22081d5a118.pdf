{
  "law_sources": {
    "name": "نظام السجن والتوقيف",
    "type": "law",
    "jurisdiction": "المملكة العربية السعودية",
    "issuing_authority": "نائب ملك المملكة العربية السعودية (مرسوم ملكي رقم م/31 بتاريخ 21 / 6 / 1398)",
    "issue_date": "1398/06/21هـ",
    "description": "نظام ينظم تنفيذ عقوبات السجن والإيداع في دور التوقيف، ويحدد قواعد إنشاء وإدارة السجون، ومعاملة المسجونين والموقوفين (الرعاية الصحية، التعليم، الجزاءات، الإفراج تحت شرط)، والأحكام المتعلقة بالقوة المسلحة.",
    "status": "processed",
    "source_url": "",
    "articles": [
      {
        "article": "المادة 1",
        "text": "تنفذ عقوبات السجن في **السجون**، و**يودع من يصدر بشأنه أمر توقيف من السلطات المختصة دور التوقيف** وذلك وفقا لأحكام هذا النظام ولائحته التنفيذية. ومع عدم الإخلال بالقواعد المتعلقة ب**معاملة الأحداث**.",
        "keywords": [
          "عقوبات السجن",
          "دور التوقيف",
          "أمر توقيف",
          "معاملة الأحداث"
        ],
        "order_index": 1
      },
      {
        "article": "المادة 2",
        "text": "تنشأ بقرارات من **وزير الداخلية سجون للرجال وأخرى للنساء ودور توقيف للرجال وأخرى للنساء** على أن يراعى في إنشائها الاستجابة لحاجات وحدات التقسيم الإداري للمملكة وتحدد اللائحة التنفيذية **قواعد إدارة السجون ودور التوقيف وسجلاتها والقواعد الخاصة بحراستها، والشروط الصحية ووسائل السلامة فيها**.",
        "keywords": [
          "إنشاء السجون ودور التوقيف",
          "وزير الداخلية",
          "تقسيم إداري",
          "شروط صحية وسلامة"
        ],
        "order_index": 2
      },
      {
        "article": "المادة 3",
        "text": "يشرف على تنفيذ العقوبات وأوامر التوقيف **مديرية عامة للسجون تتبع وزارة الداخلية** وتمارس اختصاصاتها في المناطق المختلفة بالمملكة بواسطة أجهزة تابعة لها، وذلك طبقا للأوضاع التي تحددها اللائحة التنفيذية.",
        "keywords": [
          "مديرية عامة للسجون",
          "تتبع وزارة الداخلية",
          "الإشراف على التنفيذ"
        ],
        "order_index": 3
      },
      {
        "article": "المادة 4",
        "text": "ل**وزير الداخلية في الجرائم التي تمس الأمن الوطني أن يأمر بتنفيذ السجن والتوقيف بواسطة إدارة خاصة** وله كذلك أن يأمر ب**تنفيذ سجن الأجانب وتوقيفهم في أماكن خاصة أو أقسام خاصة** في دور السجن والتوقيف، ويمارس المدنيون والعسكريون المختصون بتنفيذ عقوبات السجن وأوامر التوقيف في الجرائم التي تمس الأمن الوطني صلاحياتهم وفقا لأحكام اللائحة التنفيذية.",
        "keywords": [
          "جرائم الأمن الوطني",
          "إدارة خاصة للتنفيذ",
          "سجن وتوقيف الأجانب",
          "وزير الداخلية"
        ],
        "order_index": 4
      },
      {
        "article": "المادة 5",
        "text": "تخضع السجون ودور التوقيف ل**لتفتيش القضائي والإداري والصحي والاجتماعي** وذلك وفقا لأحكام اللائحة التنفيذية.",
        "keywords": [
          "تفتيش السجون",
          "تفتيش قضائي وإداري وصحي واجتماعي"
        ],
        "order_index": 5
      },
      {
        "article": "المادة 6",
        "text": "ينشئ وزير الداخلية بقرار يصدره **مجلسا أعلى للسجون** تكون مهمته **إجراء الدراسات الخاصة بتطوير دور السجن والتوقيف على نحو يحقق الهدف منها** ، ويجعلها أكثر فعالية في تقويم المحكوم عليهم وتأهيلهم ليكونوا أعضاء صالحين في المجتمع بعد قضائهم المدة المحكوم بها عليهم، ويحدد القرار **عدد أعضاء هذا المجلس وتشكيله واختصاصاته**.",
        "keywords": [
          "المجلس الأعلى للسجون",
          "تطوير دور السجن والتوقيف",
          "تقويم المحكوم عليهم",
          "تأهيل المسجونين"
        ],
        "order_index": 6
      },
      {
        "article": "المادة 7",
        "text": "يجب على المحكمة أو الجهة المختصة بإصدار الحكم أو أمر التوقيف **تسليم نسخة من الحكم أو الأمر إلى مديرية عامة السجون فور صدوره**. ويجب على المديرية العامة للسجون **إبلاغ المحكمة أو الجهة المختصة بتاريخ الإفراج عن المسجون أو الموقوف**. وتحدد اللائحة التنفيذية **الإجراءات الخاصة بذلك**.",
        "keywords": [
          "تسليم نسخة الحكم أو الأمر",
          "إبلاغ تاريخ الإفراج",
          "الإجراءات الخاصة"
        ],
        "order_index": 7
      },
      {
        "article": "المادة 8",
        "text": "يجب على المحكمة أو الجهة المختصة بإصدار الحكم أو أمر التوقيف **تسليم نسخة من الحكم أو الأمر إلى مديرية عامة السجون فور صدوره**. ويجب على المديرية العامة للسجون **إبلاغ المحكمة أو الجهة المختصة بتاريخ الإفراج عن المسجون أو الموقوف**. وتحدد اللائحة التنفيذية **الإجراءات الخاصة بذلك**.",
        "keywords": [
          "تسليم نسخة الحكم أو الأمر",
          "إبلاغ تاريخ الإفراج",
          "الإجراءات الخاصة"
        ],
        "order_index": 8
      },
      {
        "article": "المادة 9",
        "text": "يجب على المسجون أو الموقوف **الخضوع لفحص طبي قبل الدخول إلى السجن أو دار التوقيف** وتحدد اللائحة التنفيذية **الإجراءات الخاصة بذلك**.",
        "keywords": [
          "فحص طبي قبل الدخول",
          "الإجراءات الخاصة"
        ],
        "order_index": 9
      },
      {
        "article": "المادة 10",
        "text": "يجب على المسجون أو الموقوف **الخضوع لفحص طبي قبل الدخول إلى السجن أو دار التوقيف** وتحدد اللائحة التنفيذية **الإجراءات الخاصة بذلك**.",
        "keywords": [
          "فحص طبي قبل الدخول",
          "الإجراءات الخاصة"
        ],
        "order_index": 10
      },
      {
        "article": "المادة 11",
        "text": "يجوز للمسجونين والموقوفين **الحفاظ على ملابسهم الخاصة** إذا كانت نظيفة ومناسبة، وفقا للشروط التي تحددها اللائحة التنفيذية.",
