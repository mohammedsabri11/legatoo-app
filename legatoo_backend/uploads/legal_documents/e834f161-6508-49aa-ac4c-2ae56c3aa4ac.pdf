{
  "law_sources": {
    "name": "نظام السجل التجاري",
    "type": "law",
    "jurisdiction": "المملكة العربية السعودية",
    "issuing_authority": "المرسوم الملكي رقم (م/83) وتاريخ 1446/03/19هـ",
    "issue_date": "1446/03/19هـ",
    "description": "ينظم هذا النظام إجراءات القيد في السجل التجاري للتجار، ويهدف إلى تعزيز الشفافية والموثوقية في بيانات الأعمال التجارية وضمان تحديثها بشكل دوري.",
    "status": "processed",
    "source_url": "https://laws.boe.gov.sa/BoeLaws/Laws/LawDetails/98ee4b51-d398-4323-ae69-b2b8009f3156/1",
    "articles": [
      {
        "article": "المادة 1",
        "text": "تحدد المادة التعريفات الأساسية مثل: النظام، الوزارة، الوزير، التاجر، السجل التجاري، والمسجل.",
        "keywords": [
          "تعريفات",
          "التاجر",
          "السجل التجاري",
          "المسجل",
          "وزارة التجارة"
        ],
        "order_index": 1
      },
      {
        "article": "المادة 2",
        "text": "يهدف النظام إلى تيسير مزاولة الأعمال التجارية وضمان الشفافية والموثوقية من خلال بيانات دقيقة ومحدثة.",
        "keywords": [
          "الشفافية",
          "الموثوقية",
          "الأهداف",
          "مزاولة الأعمال"
        ],
        "order_index": 2
      },
      {
        "article": "المادة 3",
        "text": "تنشئ الوزارة السجل التجاري المركزي وتدير قاعدة بياناته إلكترونياً لتضم بيانات جميع التجار.",
        "keywords": [
          "السجل التجاري",
          "وزارة التجارة",
          "بيانات إلكترونية"
        ],
        "order_index": 3
      },
      {
        "article": "المادة 4",
        "text": "يبين اختصاصات المسجل مثل القيد، التوصيات، تصحيح البيانات، وطلب المعلومات من الجهات المختصة.",
        "keywords": [
          "المسجل",
          "اختصاصات",
          "تصحيح البيانات",
          "الجهات الحكومية"
        ],
        "order_index": 4
      },
      {
        "article": "المادة 5",
        "text": "يجب على كل تاجر القيد في السجل التجاري، ويجوز للوزارة استثناء بعض الفئات وفق اللائحة.",
        "keywords": [
          "القيد الإلزامي",
          "التاجر",
          "الاستثناءات"
        ],
        "order_index": 5
      },
      {
        "article": "المادة 6",
        "text": "يجب أن يتضمن طلب القيد بيانات التاجر، الاسم التجاري، الشكل النظامي، رأس المال، والمديرين.",
        "keywords": [
          "طلب القيد",
          "البيانات",
          "الاسم التجاري",
          "الشكل النظامي"
        ],
        "order_index": 6
      },
      {
        "article": "المادة 7",
        "text": "يقدم الطلب إلكترونياً ويبت المسجل فيه خلال عشرة أيام مع إمكانية التظلم خلال ستين يوماً عند الرفض.",
        "keywords": [
          "القيد",
          "الوزارة",
          "المسجل",
          "التظلم"
        ],
        "order_index": 7
      },
      {
        "article": "المادة 8",
        "text": "يكون التقديم والإجراءات إلكترونياً بالكامل، وتوضح اللائحة الأحكام الاستثنائية لذلك.",
        "keywords": [
          "التقديم الإلكتروني",
          "اللائحة التنفيذية",
          "الإجراءات"
        ],
        "order_index": 8
      },
      {
        "article": "المادة 9",
        "text": "يصدر للتاجر رقم سجل تجاري وشهادة قيد تحتوي على بياناته الأساسية، ويجب على التاجر الاحتفاظ بها.",
        "keywords": [
          "رقم السجل",
          "شهادة القيد",
          "البيانات الأساسية"
        ],
        "order_index": 9
      },
      {
        "article": "المادة 10",
        "text": "يجب على التاجر استخدام الرقم التجاري في معاملاته ووثائقه، ويحدد الوزير الوثائق التي يجب تضمينها لهذا الرقم.",
        "keywords": [
          "استخدام الرقم",
          "الوثائق",
          "المعاملات"
        ],
        "order_index": 10
      },
      {
        "article": "المادة 11",
        "text": "يجب على التاجر تحديث بياناته خلال ثلاثين يوماً من أي تغيير، ويحدد المسجل الإجراءات لذلك.",
        "keywords": [
          "التحديث",
          "التغييرات",
          "الإجراءات"
        ],
        "order_index": 11
      },
      {
        "article": "المادة 12",
        "text": "يجوز للمسجل تعديل البيانات من تلقاء نفسه أو بناء على طلب الجهات المختصة.",
        "keywords": [
          "تعديل البيانات",
          "المسجل",
          "الجهات المختصة"
        ],
        "order_index": 12
      },
      {
        "article": "المادة 13",
        "text": "يتم إصدار قيد فرعي لكل فرع تجاري، ويجب على التاجر تحديث بياناته عند الإغلاق أو النقل.",
        "keywords": [
          "القيد الفرعي",
          "الفروع",
          "التحديث"
        ],
        "order_index": 13
      },
      {
        "article": "المادة 14",
        "text": "يجوز للمسجل رفض القيد إذا كان مخالفاً للنظام أو لوائحه، ويخطر الطالب بالرفض مع الأسباب.",
        "keywords": [
          "رفض القيد",
          "الإخطار",
          "الأسباب"
        ],
        "order_index": 14
      },
      {
        "article": "المادة 15",
        "text": "يجوز لمن رفض طلبه التظلم أمام المحكمة المختصة خلال ثلاثين يوماً من الإخطار.",
        "keywords": [
          "التظلم",
          "المحكمة",
          "الرفض"
        ],
        "order_index": 15
      },
      {
        "article": "المادة 16",
        "text": "يتم شطب القيد عند وفاة التاجر أو فقدان أهليته أو الإفلاس أو رد الاعتبار أو التصفية.",
        "keywords": [
          "الشطب",
          "الوفاة",
          "الإفلاس",
          "رد الاعتبار",
          "التصفية"
        ],
        "order_index": 16
      },
      {
        "article": "المادة 17",
        "text": "يتم شطب القيد عند وفاة التاجر أو فقدان أهليته أو الإفلاس أو رد الاعتبار أو التصفية.",
        "keywords": [
          "الشطب",
          "الوفاة",
          "الإفلاس",
          "رد الاعتبار",
          "التصفية"
        ],
        "order_index": 17
      },
      {
        "article": "المادة 18",
        "text": "يتم شطب القيد عند وفاة التاجر أو فقدان أهليته أو الإفلاس أو رد الاعتبار أو التصفية.",
        "keywords": [
          "الشطب",
          "الوفاة",
          "الإفلاس",
          "رد الاعتبار",
          "التصفية"
        ],
        "order_index": 18
      },
      {
        "article": "المادة 19",
        "text": "يتم شطب القيد عند وفاة التاجر أو فقدان أهليته أو الإفلاس أو رد الاعتبار أو التصفية.",
        "keywords": [
          "الشطب",
          "الوفاة",
          "الإفلاس",
          "رد الاعتبار",
          "التصفية"
        ],
        "order_index": 19
      },
      {
        "article": "المادة 20",
        "text": "يتم شطب القيد عند وفاة التاجر أو فقدان أهليته أو الإفلاس أو رد الاعتبار أو التصفية.",
        "keywords": [
          "الشطب",
          "الوفاة",
          "الإفلاس",
          "رد الاعتبار",
          "التصفية"
        ],
        "order_index": 20
      },
      {
        "article": "المادة 21",
        "text": "يعاقب بغرامة لا تزيد على خمسين ألف ريال من يقدم بيانات غير صحيحة أو يخالف أحكام النظام.",
        "keywords": [
          "مخالفات",
          "غرامة مالية",
          "بيانات غير صحيحة"
        ],
        "order_index": 21
      },
      {
        "article": "المادة 22",
        "text": "يتولى موظفون مختصون ضبط المخالفات بقرار من الوزير وفق قواعد محددة.",
        "keywords": [
          "الضبط",
          "الموظفون",
          "وزير التجارة"
        ],
        "order_index": 22
      },
      {
        "article": "المادة 23",
        "text": "تُشكل لجنة بقرار من الوزير للنظر في المخالفات وتوقيع العقوبات.",
        "keywords": [
          "اللجنة",
          "المخالفات",
          "العقوبات"
        ],
        "order_index": 23
      },
      {
        "article": "المادة 24",
        "text": "يجوز للجنة الاكتفاء بالإنذار أو التصحيح أو إلزام التاجر بإصلاح الخطأ.",
        "keywords": [
          "إجراءات بديلة",
          "إنذار",
          "تصحيح"
        ],
        "order_index": 24
      },
      {
        "article": "المادة 25",
        "text": "يجوز التظلم من القرارات أمام المحكمة المختصة خلال ثلاثين يوماً.",
        "keywords": [
          "التظلم",
          "المحكمة",
          "العقوبات"
        ],
        "order_index": 25
      },
      {
        "article": "المادة 26",
        "text": "يجوز للوزير إسناد بعض مهمات المسجل إلى جهات عامة أو خاصة.",
        "keywords": [
          "إسناد المهمات",
          "الوزير",
          "الجهات العامة"
        ],
        "order_index": 26
      },
      {
        "article": "المادة 27",
        "text": "تحدد اللائحة المقابل المالي للخدمات المقدمة من المسجل.",
        "keywords": [
          "المقابل المالي",
          "اللائحة التنفيذية"
        ],
        "order_index": 27
      },
      {
        "article": "المادة 28",
        "text": "يصدر الوزير اللائحة خلال 180 يوماً من تاريخ نشر النظام.",
        "keywords": [
          "اللائحة التنفيذية",
          "الوزير",
          "مدة الإصدار"
        ],
        "order_index": 28
      },
      {
        "article": "المادة 29",
        "text": "يحل هذا النظام محل النظام السابق لعام 1416هـ ويعمل به بعد 180 يوماً من النشر.",
        "keywords": [
          "النفاذ",
          "الإلغاء",
          "النظام السابق",
          "الجريدة الرسمية"
        ],
        "order_index": 29
      }
    ]
  }
}